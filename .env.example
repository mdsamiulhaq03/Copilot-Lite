# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your key never goes to GitHub.

# Groq (used by both agents). Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Keep LangSmith tracing off, so nothing is sent outside
LANGSMITH_TRACING=false

# Debugger Agent: the MCP server address, and the tenant whose logs it fetches
# when the user does not name one. (docker-compose.yml sets the Docker address.)
MCP_SERVER_URL=http://localhost:8002/mcp
DEFAULT_TENANT_ID=demo-tenant
